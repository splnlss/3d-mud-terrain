# Non-secret settings for the .paradev scripts. Committed; never put secret values here.

# Doppler project/config injected by with-secrets.sh. Leave DOPPLER_PROJECT empty to disable.
DOPPLER_PROJECT=""
DOPPLER_CONFIG='dev'

# One port per name, from this workspace's block: PORT_WEB, PORT_API, ... PORT is the first.
PORT_NAMES='web'
PORT_RANGE_START=20000
PORT_BLOCK_SIZE=10
PORT_BLOCK_COUNT=200

# Empty means detect from the lockfile.
INSTALL_CMD=""
# Empty means "<package manager> run dev". Frameworks that ignore $PORT need it passed,
# e.g. DEV_CMD='npx vite --host 0.0.0.0 --port "$PORT" --strictPort'
DEV_CMD=""
AGENT_FILES_SOURCE='splnlss/3d-story-app@75a241cf64ba900e4b7da28b7ce352984c3af4f0'
