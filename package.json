{
  "name": "san-luis-relief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:assets": "node scripts/validate-assets.mjs",
    "bake": "uv run python -m bake",
    "bake:full": "uv run python -m bake --full --compress",
    "setup:bake": "uv sync && uv run python scripts/setup_tools.py",
    "bake:style": "uv run python -m bake --full --style --material --compress",
    "bake:scene": "uv run python -m bake --full --style --material --water --imagery --compress",
    "test": "uv run pytest && node --experimental-strip-types --test tests/*.test.ts",
    "bake:patch": "uv run python -m bake.style --config configs/style-patch.json --output data/style-patch",
    "refine:patch": "uv run python -m bake.style.refine --render"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "3d-tiles-renderer": "0.5.4",
    "meshoptimizer": "^1.3.0",
    "playcanvas": "2.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
